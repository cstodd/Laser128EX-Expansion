540 RETURN
600 H$ = "0123456789ABCDEF" : FOR K = 4 TO 0 STEP - 1 : P = 16 ^ K : D = INT(N / P) : N = N - D * P : PRINT MID$(H$,D + 1,1); : NEXT K : RETURN
700 PRINT RIGHT$("0" + STR$(V),2); : RETURN
