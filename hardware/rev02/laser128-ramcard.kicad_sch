  (text "Laser 128 / 128EX battery-backed 1MB SRAM expansion + RTC  (architecture B, see docs/design-notes.md)"
    (at 25.4 15.24 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left bottom))
    (uuid "783dd631-4434-54da-b164-e2b32fa6280a"))
  (text "Row register U2 (574) captures ERA0-7 on /RASB fall; column latch U3 (573) is transparent until the first /ECASn fall. CPLD holds ERA8 (MA8/MA17) and bank bits."
    (at 25.4 19.05 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left bottom))
    (uuid "858fd5c0-6be4-5e6d-9be9-ffbf362bce24"))
  (text "SRAM U5/U6: AS6C4008-55PCN, or CY62148ELL-45ZSXI on a TSOP-II-32 to DIP-32 adapter (~9 ns more margin at 3.6 MHz)."
    (at 25.4 22.86 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left bottom))
    (uuid "e0d2b3d7-cd56-5283-9fc2-4c756e1bd180"))
  (text "U5 = bank 0 (512K), U6 = bank 1. Both CE# from MAX693A CE OUT (battery write-protect); CPLD selects chip with OEn/WEn."
    (at 25.4 26.67 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left bottom))
    (uuid "b521101b-3843-5aef-8eb9-0f57896f8e8d"))
